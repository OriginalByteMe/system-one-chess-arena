# Local secrets. Gitignored. Bun loads this for scripts/*, and wrangler dev
# injects it into the Worker's `env` (verified against wrangler 4.133), so this
# one file covers both sides.
#
# Deploying needs no keys here: run `wrangler login` once. Account id and an API
# token only become necessary if a GitHub Action deploys, and then they live in
# repo secrets, not in this file.

# Jev / TypeSafe. No key yet as of 2026-09-17; leave blank and the Jev adapter
# runs against the system-one-adapter contract at TYPESAFE_BASE_URL instead.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Generative LLM persona (Phase 2). Fill in whichever one you actually have.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model ids used by the model personas.
ARENA_LLM_MODEL=
ARENA_JEV_MODEL=jev-latest

# Admin routes (POST /api/seasons/*, GET /api/seasons/:id/standings). Absent
# means those routes refuse every request, which is the safe local default.
ARENA_ADMIN_TOKEN=

# Season the front page opens on. Empty means "most recently scheduled".
# In deployment this is a `vars` entry in wrangler.jsonc, not a secret.
ARENA_FEATURED_SEASON=

# Cloudflare Access, guarding /api/admin/*. Both empty means those routes
# refuse every request. See DEPLOY.md for where each value comes from.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Analytics Engine SQL API, for reading back what ANALYTICS wrote. The
# account id is a `vars` entry; the token is a real secret (read scope only).
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=

# Cloudflare Access + account identifiers, consumed by scripts/deploy.ts.
# Team domain: Zero Trust > Settings > Custom Pages, or the org login URL.
# AUD: Zero Trust > Access > Applications > (the app in front of /admin).
# Account id: the hex in any dashboard URL.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCOUNT_ID=
